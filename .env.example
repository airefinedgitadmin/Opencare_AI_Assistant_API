# Runtime environment: local | development | staging | production
CAREPLAN_AI_ENVIRONMENT=local
CAREPLAN_AI_LOG_LEVEL=INFO

# --- inbound auth: shared secret the Java backend sends as the X-Api-Key header ---
CAREPLAN_AI_API_KEY=change-me

# --- azure openai ---
CAREPLAN_AI_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
CAREPLAN_AI_AZURE_OPENAI_API_KEY=change-me
# The Azure deployment alias to call - a human-chosen name, not necessarily
# the same string as the underlying model (see CAREPLAN_AI_MODEL_ID below).
CAREPLAN_AI_AZURE_OPENAI_DEPLOYMENT=your-gpt-deployment-name
CAREPLAN_AI_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Which entry in core/model_config.py's MODEL_REGISTRY describes the real
# model behind the deployment above - this is what drives context-window
# sizing (see CAREPLAN_AI_MAX_RESPONSE_TOKENS/PROMPT_OVERHEAD_TOKENS below).
# Optional: defaults to CAREPLAN_AI_AZURE_OPENAI_DEPLOYMENT if unset, which is
# correct as long as the deployment alias matches a registry entry's model_id.
# Set this explicitly (and add a MODEL_REGISTRY entry) when adding a new model
# or when the deployment alias doesn't match its underlying model's name.
# Validated at startup - an unregistered model_id fails fast rather than
# silently using the wrong context window.
CAREPLAN_AI_MODEL_ID=gpt-5

# --- llm tuning (optional, defaults shown) ---
CAREPLAN_AI_LLM_TEMPERATURE=0.2
CAREPLAN_AI_LLM_MAX_RETRIES=3
CAREPLAN_AI_LLM_REQUEST_TIMEOUT_SECONDS=30

# --- prompt size safety net (optional, defaults shown): the effective
# per-request limit is MODEL_REGISTRY's context_window_tokens for the
# resolved model_id, minus these two reservations. ---
CAREPLAN_AI_MAX_RESPONSE_TOKENS=2000
CAREPLAN_AI_PROMPT_OVERHEAD_TOKENS=1500

# --- rate limiting (optional, defaults shown): scoped per calling end user when
# the caller sends X-Caller-Fingerprint (a salted HMAC of the user's id, computed
# by Java - this service never sees or can reverse-engineer the real user id,
# only an opaque per-caller token), falling back to the X-Api-Key value.
# NOTE - this is a FAIRNESS mechanism among trusted callers, not a security
# control: anyone who already holds CAREPLAN_AI_API_KEY could set an arbitrary
# X-Caller-Fingerprint value to mint themselves a fresh limit. The real security
# boundary is keeping CAREPLAN_AI_API_KEY secret, the same as any other
# shared-secret credential in this system. ---
CAREPLAN_AI_RATE_LIMIT_REQUESTS=10
CAREPLAN_AI_RATE_LIMIT_WINDOW_SECONDS=60
