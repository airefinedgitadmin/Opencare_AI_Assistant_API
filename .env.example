# Runtime environment: local | development | staging | production
CAREPLAN_AI_ENVIRONMENT=local
CAREPLAN_AI_LOG_LEVEL=INFO

# --- inbound auth: shared secret the Java backend sends as the X-Api-Key header ---
CAREPLAN_AI_API_KEY=change-me

# --- azure openai ---
CAREPLAN_AI_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
CAREPLAN_AI_AZURE_OPENAI_API_KEY=change-me
# The Azure deployment alias to call - a human-chosen name, not necessarily
# the same string as the underlying model (see CAREPLAN_AI_MODEL_ID below).
CAREPLAN_AI_AZURE_OPENAI_DEPLOYMENT=your-gpt-deployment-name
CAREPLAN_AI_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Which entry in core/model_config.py's MODEL_REGISTRY describes the real
# model behind the deployment above - this is what drives context-window
# sizing (see CAREPLAN_AI_MAX_RESPONSE_TOKENS/PROMPT_OVERHEAD_TOKENS below).
# Optional: defaults to CAREPLAN_AI_AZURE_OPENAI_DEPLOYMENT if unset, which is
# correct as long as the deployment alias matches a registry entry's model_id.
# Set this explicitly (and add a MODEL_REGISTRY entry) when adding a new model
# or when the deployment alias doesn't match its underlying model's name.
# Validated at startup - an unregistered model_id fails fast rather than
# silently using the wrong context window.
CAREPLAN_AI_MODEL_ID=gpt-5

# --- llm tuning (optional, defaults shown) ---
CAREPLAN_AI_LLM_TEMPERATURE=0.2
CAREPLAN_AI_LLM_MAX_RETRIES=3
CAREPLAN_AI_LLM_REQUEST_TIMEOUT_SECONDS=30

# --- prompt size safety net (optional, defaults shown): the effective
# per-request limit is MODEL_REGISTRY's context_window_tokens for the
# resolved model_id, minus these two reservations. ---
CAREPLAN_AI_MAX_RESPONSE_TOKENS=2000
CAREPLAN_AI_PROMPT_OVERHEAD_TOKENS=1500

# --- rate limiting (optional, defaults shown): scoped per calling end user when
# the caller sends X-Caller-Fingerprint (a salted HMAC of the user's id, computed
# by Java - this service never sees or can reverse-engineer the real user id,
# only an opaque per-caller token), falling back to the X-Api-Key value.
# NOTE - this is a FAIRNESS mechanism among trusted callers, not a security
# control: anyone who already holds CAREPLAN_AI_API_KEY could set an arbitrary
# X-Caller-Fingerprint value to mint themselves a fresh limit. The real security
# boundary is keeping CAREPLAN_AI_API_KEY secret, the same as any other
# shared-secret credential in this system. ---
CAREPLAN_AI_RATE_LIMIT_REQUESTS=10
CAREPLAN_AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- care plan agents (X-CarePlan-Version: 2): care plan agent + verifier agent ---
# Primary = the model both agents run on. Unset = the deployment above.
# Fallback = optional stronger model for the care plan agent's revisions.
# Deployment and model id are separate for the same reason as above; model ids
# must exist in core/model_config.py.
# CAREPLAN_AI_AGENT_PRIMARY_DEPLOYMENT=gpt-5-mini
# CAREPLAN_AI_AGENT_PRIMARY_MODEL_ID=gpt-5-mini
# CAREPLAN_AI_AGENT_FALLBACK_DEPLOYMENT=gpt-5
# CAREPLAN_AI_AGENT_FALLBACK_MODEL_ID=gpt-5
# Sent only to GPT-5-family models: minimal | low | medium | high
CAREPLAN_AI_AGENT_REASONING_EFFORT=low
# Sent only to models that accept temperature (e.g. gpt-4.1-mini)
CAREPLAN_AI_AGENT_TEMPERATURE=0
CAREPLAN_AI_AGENT_REDRAFT_TEMPERATURE=0.5
CAREPLAN_AI_AGENT_MAX_RESPONSE_TOKENS=8000
# Must-read records (assessment, previous care plans, pathway notes) are never
# cut - the request is refused if they alone exceed this many tokens.
CAREPLAN_AI_AGENT_MAX_DRAFT_EVIDENCE_TOKENS=60000
# The care plan agent's starting pack: must-read records + each need's best
# keyword matches across ALL the resident's records, to this many tokens. The
# rest stays searchable (SearchRecords tool); records never seen are listed in
# the session's `omitted`.
CAREPLAN_AI_AGENT_PACK_TOKENS=12000
CAREPLAN_AI_AGENT_PACK_MATCHES_PER_NEED=3
CAREPLAN_AI_AGENT_SEARCH_RESULTS=8
# Model turns per agent run (searching + submitting); the last is a forced submit.
CAREPLAN_AI_AGENT_MAX_TURNS=6
# Times a submitted plan may be sent back (code checks + verifier together).
CAREPLAN_AI_AGENT_MAX_REVISIONS=2
# Verifier agent: every AI statement checked against its cited quotes.
CAREPLAN_AI_AGENT_VERIFY=true
# On a 429, wait as long as Azure's Retry-After says, up to this many seconds.
CAREPLAN_AI_AGENT_RATE_LIMIT_MAX_WAIT_SECONDS=20

# --- agent memory: Postgres. Local dev = your local Postgres; create the DB
# and apply migrations with: python -m careplan_ai.memory.migrate --create-database
# Not configured = in-memory sessions (tests only - lost on restart). ---
CAREPLAN_AI_DB_HOST=localhost
CAREPLAN_AI_DB_PORT=5432
CAREPLAN_AI_DB_NAME=opencare-ai-dev
CAREPLAN_AI_DB_USER=postgres
CAREPLAN_AI_DB_PASSWORD=change-me
# "require" for Supabase / Azure Postgres; blank for local
CAREPLAN_AI_DB_SSLMODE=
# Alternative: one connection string, which wins over the parts above when set
# (GitHub Actions passes Supabase this way, from the SUPABASE_DB_URL secret).
# CAREPLAN_AI_MEMORY_DB_URL=postgresql://user:password@host:5432/dbname
CAREPLAN_AI_AGENT_SESSION_TTL_HOURS=24

####### CARE PLAN STYLE LIBRARY - RAG (OPENCARE-51, optional) #######
# Other residents' anonymised care plans from the same home, used for tone and
# style only (never as evidence). none = off (neutral house style),
# memory = tests/dev, pinecone = Pinecone (https://app.pinecone.io/).
CAREPLAN_AI_LIBRARY_PROVIDER=none
CAREPLAN_AI_LIBRARY_TOP_K=5
# Unedited AI-assisted plans rank below staff-written/edited; false = leave out.
CAREPLAN_AI_LIBRARY_INCLUDE_UNEDITED_AI=true
# CAREPLAN_AI_PINECONE_API_KEY=pcsk_...
# Created automatically on first use (integrated embedding, one namespace per home).
CAREPLAN_AI_PINECONE_INDEX_NAME=careplan-style-library
# The free (Starter) plan only offers AWS us-east-1 - not UK hosting; the DPIA
# must cover this before real care plans are indexed.
CAREPLAN_AI_PINECONE_CLOUD=aws
CAREPLAN_AI_PINECONE_REGION=us-east-1
CAREPLAN_AI_PINECONE_EMBED_MODEL=llama-text-embed-v2